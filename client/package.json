{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run backend:up && vite",
    "backend:up": "docker compose -f ../docker-compose.yml -f ../docker-compose.dev.yml up -d --build --wait server ml external-systems",
    "backend:down": "docker compose -f ../docker-compose.yml -f ../docker-compose.dev.yml down",
    "rebuild": "docker compose -f ../docker-compose.yml up -d --build --force-recreate --wait",
    "rebuild:clean": "docker compose -f ../docker-compose.yml down && docker compose -f ../docker-compose.yml build --no-cache && docker compose -f ../docker-compose.yml up -d --wait",
    "build": "tsc -b && vite build",
    "lint": "oxlint && steiger ./src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@alfalab/core-components": "^50.37.0",
    "mobx": "^7.1.0",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "steiger": "^0.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
